# Copy to deploy/staging.env (git-ignored) and fill in.
JWT_SECRET=replace-with-a-long-random-string
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-me
POSTGRES_PASSWORD=replace-me
# Image source and tag (CI publishes :latest and :<git sha>)
REGISTRY=ghcr.io/somaxsoma
TAG=latest
WEB_PORT=8080
