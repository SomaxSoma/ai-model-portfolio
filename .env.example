# Copy to .env and adjust. Every value has a development default, so .env is optional locally.

# Any PostgreSQL 14+ works. `npm run db` starts a local one on port 5433.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/portfolio

# REQUIRED in production (the API refuses to start without it when NODE_ENV=production).
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_TTL=12h

PORT=3001
HOST=127.0.0.1

# First administrator, created by `npm run seed` when no admin exists.
# Development defaults only — set real values for any shared environment.
SEED_ADMIN_NAME=Catalogue Admin
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=dev-admin-password

# Redis for the cache and job queue (optional locally; required by the worker).
# REDIS_URL=redis://localhost:6379
# Where scheduled ingestion runs: inline (inside the API, default) or off (a separate worker).
# SCHEDULER=inline
# Folder FILE ingestion sources may read from (default: ./data).
# DATA_DIR=./data
# Login/registration attempts per IP per minute.
# AUTH_RATE_LIMIT=20
